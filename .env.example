# LeaseLogic Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

# =============================================================================
# API Configuration
# =============================================================================
REACT_APP_API_URL=http://localhost:5001

# =============================================================================
# Stripe Configuration
# =============================================================================
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here

# =============================================================================
# Supabase Configuration
# =============================================================================
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# Feature Flags
# =============================================================================
# Migration: Use new config-driven document system (Task 3.1)
#   false = Use old hardcoded MVP system (default, production-safe)
#   true  = Use new DocumentService/ValidationService/TemplateService
REACT_APP_USE_NEW_DOCUMENT_SYSTEM=false

# Rent Increase Notice feature
REACT_APP_RENT_INCREASE=false

# Document Selector UI (Task 3.4)
#   false = Landing page goes directly to 3-day notice form (default)
#   true  = Landing page shows document type selector
REACT_APP_DOCUMENT_SELECTOR_ENABLED=false

# =============================================================================
# Development/Testing Flags
# =============================================================================
# Bypass geo-restriction for testing (set to true for non-Utah testing)
REACT_APP_BYPASS_GEO=false

# Bypass payment for testing (NEVER true in production!)
REACT_APP_BYPASS_PAYMENT=false
