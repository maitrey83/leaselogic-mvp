# LeaseLogic Backend - Production Environment Variables
# Set these in Render Dashboard > Environment > Environment Variables
# NEVER commit actual values to git!

# =============================================================================
# Server Configuration
# =============================================================================
NODE_ENV=production
PORT=10000

# =============================================================================
# Supabase (Database & Auth)
# =============================================================================
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# Stripe (Payments)
# =============================================================================
# Use LIVE keys for production, TEST keys for staging
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key-here

# =============================================================================
# CORS
# =============================================================================
# Additional allowed origins (comma-separated). localhost:3000 and
# leaselogic-mvp.vercel.app are always allowed.
# CORS_ALLOWED_ORIGINS=https://custom-domain.com

# =============================================================================
# Puppeteer (PDF Generation)
# =============================================================================
# Render sets this automatically with the buildpack. If needed:
# PUPPETEER_EXECUTABLE_PATH=/opt/render/.cache/puppeteer/chrome/linux-*/chrome-linux64/chrome

# =============================================================================
# Feature Flags (Production Defaults - ALL OFF)
# =============================================================================
# These are frontend flags set in Vercel, listed here for reference:
# REACT_APP_USE_NEW_DOCUMENT_SYSTEM=false
# REACT_APP_DOCUMENT_SELECTOR_ENABLED=false
# REACT_APP_RENT_INCREASE=false
# REACT_APP_BYPASS_GEO=false
# REACT_APP_BYPASS_PAYMENT=false
